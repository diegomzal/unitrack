# ─── Backend ───
PORT=3000

# Paste your Firebase Service Account Key JSON as a single-line string:
# 1. Go to Firebase Console > Project Settings > Service Accounts > Generate new private key
# 2. Copy the entire JSON content
# 3. Minify it (remove newlines) and paste it here
# Example: FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"my-project",...}
FIREBASE_SERVICE_ACCOUNT=

# ─── Frontend (Vite) ───
# Get these from Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API URL (used by frontend), For local dev:
VITE_API_URL=http://localhost:3000/api
